{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TaskContract",
  "type": "object",
  "additionalProperties": false,
  "required": ["task_id", "tenant_id", "actor_id", "objective", "acceptance_criteria", "profile", "max_risk"],
  "properties": {
    "task_id": {"type": "string", "minLength": 1},
    "tenant_id": {"type": "string", "minLength": 1},
    "actor_id": {"type": "string", "minLength": 1},
    "objective": {"type": "string", "minLength": 1},
    "acceptance_criteria": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "profile": {"enum": ["QA_READONLY", "DECISION_CHALLENGE", "RESEARCH_READONLY", "CODE_CHANGE", "SECURITY_REVIEW", "EXTERNAL_ACTION"]},
    "max_risk": {"type": "integer", "minimum": 0, "maximum": 4},
    "allowed_paths": {"type": "array", "items": {"type": "string"}},
    "allowed_tools": {"type": "array", "items": {"type": "string"}},
    "data_classification": {"type": "string"},
    "budget_seconds": {"type": "integer", "minimum": 1, "maximum": 3600},
    "desired_draft": {"type": "string"}
  }
}
